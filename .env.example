# Copy to .env and fill in. Never commit real keys.
DATABASE_URL=postgresql+psycopg://careflow:careflow@localhost:5432/careflow

# LLM providers as provider:model (groq, gemini, ollama). At least one key is needed for chat.
LLM_PRIMARY=groq:openai/gpt-oss-120b
LLM_FALLBACK=gemini:gemini-3.5-flash-lite
GROQ_API_KEY=
GEMINI_API_KEY=
# For local runs with Ollama, e.g. LLM_PRIMARY=ollama:qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# Retrieval models: auto = neural models when they can be downloaded, else local fallbacks.
EMBEDDING_BACKEND=auto
RERANKER_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8
MODEL_CACHE_DIR=

MAX_MESSAGES_PER_SESSION=20
MAX_MESSAGES_PER_IP_PER_HOUR=60
PROMPT_TOKEN_BUDGET=3000
RAG_TOP_K=4
DEMO_MODE=true
AUTH_SECRET=change-me-to-a-long-random-string
ALLOW_REGISTRATION=true
TRACE_DIR=traces
QUEUE_MERGE_RULE=slot_order
SIMULATOR_SEED=42
