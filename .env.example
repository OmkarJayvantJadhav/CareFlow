# Copy to .env and fill in. Never commit real keys.
DATABASE_URL=postgresql+psycopg://careflow:careflow@localhost:5432/careflow

# LLM providers as provider:model (groq, gemini, ollama). At least one key is needed for chat.
LLM_PRIMARY=groq:openai/gpt-oss-120b
LLM_FALLBACK=gemini:gemini-3.5-flash-lite
GROQ_API_KEY=
GEMINI_API_KEY=
# For local runs with Ollama, e.g. LLM_PRIMARY=ollama:qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# Retrieval models: auto = neural models when they can be downloaded, else local fallbacks.
EMBEDDING_BACKEND=auto
RERANKER_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8
MODEL_CACHE_DIR=

MAX_MESSAGES_PER_SESSION=20
MAX_MESSAGES_PER_IP_PER_HOUR=60
PROMPT_TOKEN_BUDGET=3000
RAG_TOP_K=4
DEMO_MODE=true
AUTH_SECRET=change-me-to-a-long-random-string
# Encrypts patients' phone numbers (python -m app.manage new-data-key); without it one is derived from AUTH_SECRET.
DATA_KEY=
ALLOW_REGISTRATION=true
# A hospital's own deployment: DEMO_MODE=false, and the first admin (created at start-up only if no admin can
# sign in yet; the password must be changed at the first sign-in). See docs/DEPLOY.md.
# INITIAL_ADMIN_USERNAME=
# INITIAL_ADMIN_PASSWORD=
# INITIAL_ADMIN_NAME=
# Messages by SMS and e-mail (docs/DEPLOY.md): none, log, twilio or webhook / none, log or smtp.
# Nothing is sent until an admin also turns sending on; real providers never send in demo mode.
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

TRACE_DIR=traces
QUEUE_MERGE_RULE=slot_order
SIMULATOR_SEED=42
